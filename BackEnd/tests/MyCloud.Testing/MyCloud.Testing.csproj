<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test helpers: test JWT signing and trusting the test key instead of Identity's JWKS. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Thư viện, không phải project test: bỏ các gói chạy test mà tests/Directory.Build.props thêm vào. -->
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Remove="coverlet.collector" />
  </ItemGroup>
</Project>
