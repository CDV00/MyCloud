<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Byte của file và dung lượng (docs/03 §4). Một project chia theo tính năng (Blobs, Quotas, Uploads, ObjectStorage,
    Grpc, Http): logic chủ yếu là điều phối S3 + quota, không có domain phức tạp để tách 4 tầng như Drive.
  -->
  <PropertyGroup>
    <UserSecretsId>mycloud-storage-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\..\Contracts\Protos\mycloud\storage\v1\storage_service.proto"
              ProtoRoot="..\..\..\Contracts\Protos"
              GrpcServices="Both"
              Link="Protos\storage_service.proto" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\MyCloud.ServiceDefaults\MyCloud.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\MyCloud.BuildingBlocks.Web\MyCloud.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\MyCloud.BuildingBlocks.Messaging\MyCloud.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\MyCloud.BuildingBlocks.Grpc\MyCloud.BuildingBlocks.Grpc.csproj" />
    <ProjectReference Include="..\..\..\Contracts\MyCloud.Contracts.Events\MyCloud.Contracts.Events.csproj" />
  </ItemGroup>
</Project>
