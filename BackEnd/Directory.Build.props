<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1848/CA1873: LoggerMessage source generator — chưa bắt buộc ở Phase 0.
         CA1711/CA1716/CA1720: tên kiểu như Error, Result, IUnitOfWork... là chủ ý.
         CA1062: đã có nullable reference types. CA2007: ASP.NET Core không có SynchronizationContext. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1711;CA1716;CA1720;CA1062;CA2007;CA1515;CA1031;CA1724;CA1034;CA1000;CA1812</NoWarn>
  </PropertyGroup>
</Project>
