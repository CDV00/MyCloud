{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5101"
      },
      "grpc": {
        "Url": "http://localhost:5111",
        "Protocols": "Http2"
      }
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "mycloud-identity",
      "Audience": "mycloud-api",
      "MetadataAddress": ""
    }
  },
  "Tokens": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshReuseLeeway": "00:00:10",
    "CookieName": "mycloud_rt",
    "CookiePath": "/api/identity/v1/auth"
  },
  "SigningKeys": {
    "RotationInterval": "90.00:00:00",
    "ActivationDelay": "02:00:00",
    "RetentionAfterRotation": "1.00:00:00",
    "KeySizeBits": 2048
  }
}
