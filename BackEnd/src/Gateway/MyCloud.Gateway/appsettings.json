{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "mycloud-identity",
      "Audience": "mycloud-api"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 5,
    "AuthPermitsPerMinute": 30,
    "ApiPermitsPerSecond": 100
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/api/identity/{version}/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/{version}/auth/login" } ]
      },
      "identity-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/api/identity/{version}/auth/register", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/{version}/auth/register" } ]
      },
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/identity/{version}/auth/{**rest}" },
        "Transforms": [ { "PathPattern": "/api/{version}/auth/{**rest}" } ]
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "drive": {
        "ClusterId": "drive",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/drive/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "storage": {
        "ClusterId": "storage",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/storage/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "sharing": {
        "ClusterId": "sharing",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/sharing/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "search": {
        "ClusterId": "search",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "notification": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity" } } },
      "drive": { "Destinations": { "d1": { "Address": "http://drive" } } },
      "storage": { "Destinations": { "d1": { "Address": "http://storage" } } },
      "sharing": { "Destinations": { "d1": { "Address": "http://sharing" } } },
      "search": { "Destinations": { "d1": { "Address": "http://search" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://notification" } } }
    }
  }
}
